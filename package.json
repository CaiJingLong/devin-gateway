{
  "name": "devin-gateway",
  "version": "0.5.1",
  "license": "MIT",
  "author": "CaiJingLong",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./proto": {
      "types": "./dist/proto.d.ts",
      "default": "./dist/proto.js"
    },
    "./models": {
      "types": "./dist/models.d.ts",
      "default": "./dist/models.js"
    },
    "./convert": {
      "types": "./dist/convert.d.ts",
      "default": "./dist/convert.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "default": "./dist/config.js"
    },
    "./devin": {
      "types": "./dist/devin.d.ts",
      "default": "./dist/devin.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "devin-gateway": "./dist/bin/gateway.js",
    "devin-gateway-login": "./dist/bin/gateway.js"
  },
  "files": [
    "dist",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/caijinglong/devin-gateway.git"
  },
  "homepage": "https://github.com/caijinglong/devin-gateway#readme",
  "bugs": {
    "url": "https://github.com/caijinglong/devin-gateway/issues"
  },
  "keywords": [
    "devin",
    "windsurf",
    "cascade",
    "openai",
    "anthropic",
    "gateway",
    "proxy",
    "llm",
    "chat-completions",
    "cherry-studio"
  ],
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "login": "bun run src/cli/login.ts",
    "login:paste": "bun run src/cli/login.ts --paste",
    "login:status": "bun run src/cli/login.ts --status",
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "prepack": "bun run typecheck && bun run build"
  },
  "dependencies": {},
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@types/bun": "latest",
    "@types/node": "latest",
    "openai": "^6.49.0",
    "typescript": "^5"
  }
}
