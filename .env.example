# Devin session token — optional fallback for requests that omit Authorization/x-api-key
DEVIN_API_KEY=

# Gateway listen port
PORT=3000

# Gateway listen host
HOST=0.0.0.0

# Optional: override Devin API base URL
DEVIN_BASE_URL=
# Log level: debug | info | warn | error (default: info)
LOG_LEVEL=info

# Debug mode: set to true|1|yes to force verbose (debug-level) logs and tee
# them to LOG_FILE (default logs/gateway.log, or /app/logs/gateway.log in
# Docker). Default: off. Docker: `DEBUG=true docker compose up` to enable,
# logs persist to the host ./logs/ via the bind mount.
DEBUG=false
# Optional: override the log file path (default: logs/gateway.log relative to CWD)
LOG_FILE=

# Error trace: on by default. When a request fails (4xx/5xx or upstream
# error), writes a single file with the full request context (method, path,
# headers, body, token fingerprint, upstream calls, error stack) to
# ERROR_TRACE_DIR (default logs/errors). Set ERROR_TRACE=false to disable.
ERROR_TRACE=true
# Optional: override the error trace output directory
ERROR_TRACE_DIR=

# Live integration tests require both DEVIN_API_KEY and DEVIN_MODEL:
#   DEVIN_API_KEY=... DEVIN_MODEL=glm-5-2 bun test test/live.test.ts
DEVIN_MODEL=
